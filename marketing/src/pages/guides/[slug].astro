---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => !data.draft);
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}
const { guide } = Astro.props;
const { Content } = await render(guide);
const { title, description, published, updated, faq } = guide.data;
const url = new URL(`/guides/${guide.id}`, Astro.site).href;
const fmt = (d: Date) => d.toLocaleDateString("en-MY", { day: "numeric", month: "long", year: "numeric" });

const jsonLd: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description,
    datePublished: published.toISOString(),
    dateModified: (updated ?? published).toISOString(),
    mainEntityOfPage: url,
    author: { "@type": "Organization", name: "QCON", url: "https://qcon.solutions/" },
    publisher: { "@type": "Organization", name: "QCON", logo: { "@type": "ImageObject", url: "https://qcon.solutions/favicon.svg" } },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: "https://qcon.solutions/" },
      { "@type": "ListItem", position: 2, name: "Guides", item: "https://qcon.solutions/guides" },
      { "@type": "ListItem", position: 3, name: title, item: url },
    ],
  },
];
if (faq.length) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  });
}
---
<Base title={`${title} | QCON`} description={description} jsonLd={jsonLd} ogType="article">
  <article class="py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="text-sm text-muted-foreground" aria-label="Breadcrumb">
        <a href="/" class="hover:text-foreground">Home</a> / <a href="/guides" class="hover:text-foreground">Guides</a>
      </nav>
      <h1 class="mt-4 text-3xl md:text-4xl font-bold tracking-tight text-foreground">{title}</h1>
      <p class="mt-3 text-sm text-muted-foreground">
        {updated ? <>Updated <time datetime={updated.toISOString()}>{fmt(updated)}</time></> : <>Published <time datetime={published.toISOString()}>{fmt(published)}</time></>}
      </p>

      <div class="article mt-8">
        <Content />
      </div>

      {faq.length > 0 && (
        <section class="mt-14">
          <h2 class="text-2xl font-bold tracking-tight">Frequently asked questions</h2>
          <dl class="mt-6 space-y-6">
            {faq.map((f) => (
              <div>
                <dt class="font-semibold text-lg">{f.q}</dt>
                <dd class="mt-1 text-muted-foreground" style="font-size:1.05rem;line-height:1.7">{f.a}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      <aside class="mt-14 rounded-lg bg-primary text-primary-foreground p-8 text-center">
        <h2 class="text-2xl font-bold">Build this quotation in QCON</h2>
        <p class="mt-2 opacity-90">Material &amp; labour breakdown, automatic margins and a professional PDF, in minutes.</p>
        <a href="/register" class="btn btn-secondary btn-lg mt-6">Create Your First Quotation<Icon name="arrow-right" class="ml-2 h-5 w-5" /></a>
        <p class="mt-4 text-sm opacity-75">Free to get started. No credit card required.</p>
      </aside>
    </div>
  </article>
</Base>
