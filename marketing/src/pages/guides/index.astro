---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";

const guides = (await getCollection("guides", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
---
<Base
  noindex={guides.length === 0}
  title="Quotation Guides for Contractors & Interior Designers | QCON"
  description="Practical guides on pricing, writing and sending renovation and interior design quotations in Malaysia."
>
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl md:text-4xl font-bold tracking-tight">Guides</h1>
      <p class="mt-3 text-lg text-muted-foreground">Practical help with pricing and quoting renovation and interior design work.</p>
      <ul class="mt-10 grid gap-4">
        {guides.map((g) => (
          <li>
            <a href={`/guides/${g.id}`} class="card block p-6 hover:border-primary transition-colors">
              <h2 class="text-xl font-semibold text-foreground">{g.data.title}</h2>
              <p class="mt-2 text-muted-foreground">{g.data.description}</p>
              <span class="mt-3 inline-flex items-center gap-1 text-primary font-medium">Read guide <Icon name="chevron-right" class="h-4 w-4" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
