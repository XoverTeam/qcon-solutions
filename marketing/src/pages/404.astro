---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found | QCON" description="This page doesn't exist." noindex>
  <section class="py-24">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <p class="text-primary font-semibold">404</p>
      <h1 class="mt-2 text-3xl md:text-4xl font-bold tracking-tight">We couldn't find that page</h1>
      <p class="mt-4 text-lg text-muted-foreground">The link may be old or mistyped.</p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn btn-primary btn-lg">Go to homepage</a>
        <a href="/login" class="btn btn-outline btn-lg">Sign in</a>
      </div>
    </div>
  </section>
</Base>
