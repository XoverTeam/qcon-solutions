---
import { getCollection } from "astro:content";
import Logo from "./Logo.astro";
const hasGuides = (await getCollection("guides", ({ data }) => !data.draft)).length > 0;
const year = new Date().getFullYear();
---
<footer class="py-12 border-t bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <a href="/" class="inline-flex items-center gap-2" aria-label="QCON home">
        <Logo size={24} />
        <span class="font-brand" style="font-size:17px;line-height:1;color:rgb(17,24,39)">QCON</span>
      </a>
      <p class="text-sm text-muted-foreground text-center">Quotation software for interior design &amp; construction companies</p>
    </div>
    <nav class="mt-6 flex flex-wrap justify-center md:justify-end gap-x-6 gap-y-2 text-sm text-muted-foreground" aria-label="Footer">
      <a href="/quotation-software-malaysia" class="hover:text-foreground">Quotation software Malaysia</a>
      {hasGuides && <a href="/guides/" class="hover:text-foreground">Guides</a>}
      <a href="/contact-support" class="hover:text-foreground">Contact support</a>
      <a href="/privacy-policy" class="hover:text-foreground">Privacy policy</a>
      <span>© {year} QCON</span>
    </nav>
  </div>
</footer>
