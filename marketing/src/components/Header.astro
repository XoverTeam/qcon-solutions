---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
---
<header class="bg-card border-b border-border shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <a href="/" class="flex items-center space-x-3" aria-label="QCON home">
        <Logo size={36} />
        <span class="text-xl font-semibold text-foreground font-brand">QCON</span>
      </a>
      <nav class="flex items-center gap-3" aria-label="Main">
        <a href="/contact-support" class="btn btn-ghost btn-sm gap-1">
          <Icon name="message-square" class="h-4 w-4" />
          <span class="hidden sm:inline">Support</span>
        </a>
        <a href="/login" class="btn btn-ghost btn-md">Sign In</a>
        <a href="/register" class="btn btn-primary btn-md">Sign Up</a>
      </nav>
    </div>
  </div>
</header>
